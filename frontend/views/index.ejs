<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | FraudReturn Shield</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <div class="app-container">
    <nav class="navbar">
      <div class="nav-brand">
        <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>FraudReturn Shield</span>
      </div>
      <div class="nav-links">
        <a href="/" class="nav-link active">Проверка</a>
        <a href="/history" class="nav-link">История</a>
        <a href="/admin" class="nav-link">Настройки</a>
      </div>
      <div class="nav-status">
        <span class="status-indicator online"></span>
        <span>Система активна</span>
      </div>
    </nav>

    <main class="main-content">
      <div class="page-header">
        <h1>🔍 Проверка возврата</h1>
        <p>Введите данные о возврате для оценки риска мошенничества</p>
      </div>

      <div class="content-grid">
        <div class="card form-card">
          <div class="card-header">
            <h2>📋 Данные возврата</h2>
          </div>
          <form id="fraudForm" class="fraud-form">
            <div class="form-section">
              <h3>Информация о заказе</h3>
              <div class="form-grid">
                <div class="form-group">
                  <label for="orderNumber">Номер заказа *</label>
                  <input type="text" id="orderNumber" name="orderNumber" required placeholder="MSK-12345">
                </div>
                <div class="form-group">
                  <label for="orderAmount">Сумма заказа (₽) *</label>
                  <input type="number" id="orderAmount" name="orderAmount" required min="0" step="0.01">
                </div>
              </div>
            </div>

            <div class="form-section">
              <h3>Данные клиента</h3>
              <div class="form-grid">
                <div class="form-group">
                  <label for="accountAgeDays">Возраст аккаунта (дней) *</label>
                  <input type="number" id="accountAgeDays" name="accountAgeDays" required min="0">
                </div>
                <div class="form-group">
                  <label for="totalOrders">Всего заказов *</label>
                  <input type="number" id="totalOrders" name="totalOrders" required min="1">
                </div>
                <div class="form-group">
                  <label for="returnRate">Доля возвратов *</label>
                  <input type="number" id="returnRate" name="returnRate" required min="0" max="1" step="0.01">
                </div>
                <div class="form-group">
                  <label for="daysToReturn">Дней до возврата *</label>
                  <input type="number" id="daysToReturn" name="daysToReturn" required min="0">
                </div>
              </div>
            </div>

            <div class="form-section">
              <h3>Дополнительные признаки</h3>
              <div class="form-grid">
                <div class="form-group">
                  <label for="category">Категория товара *</label>
                  <select id="category" name="category" required>
                    <option value="">Выберите категорию</option>
                    <option value="Электроника">Электроника</option>
                    <option value="Одежда">Одежда</option>
                    <option value="Косметика">Косметика</option>
                    <option value="Книги">Книги</option>
                    <option value="Спорттовары">Спорттовары</option>
                  </select>
                </div>
                <div class="form-group checkbox-group">
                  <label class="checkbox-label">
                    <input type="checkbox" name="addressMatch" id="addressMatch">
                    <span>Адреса совпадают</span>
                  </label>
                </div>
                <div class="form-group checkbox-group">
                  <label class="checkbox-label">
                    <input type="checkbox" name="deviceNew" id="deviceNew">
                    <span>Новое устройство</span>
                  </label>
                </div>
                <div class="form-group checkbox-group">
                  <label class="checkbox-label">
                    <input type="checkbox" name="isWeekend" id="isWeekend">
                    <span>Выходной день</span>
                  </label>
                </div>
              </div>
            </div>

            <div class="form-section">
              <h3>📸 Фото товара</h3>
              <div class="file-upload">
                <input type="file" id="productPhoto" name="productPhoto" accept="image/*">
                <div class="upload-area">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="17 8 12 3 7 8"/>
                    <line x1="12" y1="3" x2="12" y2="15"/>
                  </svg>
                  <p>Перетащите фото или кликните для загрузки</p>
                  <span class="file-hint">JPG, PNG до 5 МБ</span>
                </div>
                <div class="preview-container" id="photoPreview"></div>
              </div>
            </div>

            <button type="submit" class="btn btn-primary btn-large">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
              </svg>
              Проверить риск
            </button>
          </form>
        </div>

        <div class="card result-card" id="resultCard" style="display: none;">
          <div class="card-header">
            <h2>📊 Результат проверки</h2>
            <button class="btn btn-secondary btn-small" onclick="resetForm()">Новая проверка</button>
          </div>

          <div class="risk-display">
            <div class="risk-gauge">
              <div class="gauge-circle" id="riskGauge">
                <svg viewBox="0 0 100 100">
                  <circle class="gauge-bg" cx="50" cy="50" r="45"/>
                  <circle class="gauge-fill" id="gaugeFill" cx="50" cy="50" r="45"/>
                </svg>
                <div class="gauge-value">
                  <span id="riskScore">0</span>%
                </div>
              </div>
              <div class="risk-zones">
                <div class="zone green">
                  <span>0-30%</span>
                  <small>Автоодобрение</small>
                </div>
                <div class="zone yellow">
                  <span>31-65%</span>
                  <small>Проверка</small>
                </div>
                <div class="zone red">
                  <span>66-100%</span>
                  <small>Отказ</small>
                </div>
              </div>
            </div>

            <div class="risk-info">
              <div class="info-badge" id="riskBadge">
                <span class="badge-icon">⚠️</span>
                <span class="badge-text" id="riskText">Средний риск</span>
              </div>
              <div class="recommendation" id="recommendation">
                <strong>Рекомендация:</strong>
                <p id="recommendationText">Требуется проверка оператором</p>
              </div>
            </div>
          </div>

          <div class="shap-section">
            <h3>🔍 Факторы риска (SHAP)</h3>
            <div class="shap-chart">
              <canvas id="shapChart"></canvas>
            </div>
            <div class="shap-list" id="shapList">
            </div>
          </div>

          <div class="action-buttons">
            <button class="btn btn-success" onclick="approveReturn()">
              ✅ Одобрить
            </button>
            <button class="btn btn-warning" onclick="manualReview()">
              ⚠️ На проверку
            </button>
            <button class="btn btn-danger" onclick="rejectReturn()">
              ❌ Отклонить
            </button>
          </div>
        </div>
      </div>
    </main>

    <footer class="footer">
      <div class="footer-content">
        <p>© 2026 FraudReturn Shield. Система детекции мошеннических возвратов</p>
        <p class="footer-note">Методология: Константинов А.Ф. (2025), Zhang et al. (2023)</p>
      </div>
    </footer>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/charts.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>